#!/command/with-contenv sh
# Hermes Mentor customizations, layered on top of the official image's own
# cont-init.d chain (runs after 01-hermes-setup / 02-reconcile-profiles, so
# $HERMES_HOME already exists and is hermes-owned). Config/identity/cron are
# idempotent and safe to re-run on every boot.
set -e

HERMES_HOME="${HERMES_HOME:-/opt/data}"
GITCONFIG="$HERMES_HOME/.gitconfig"

# config.yaml/SOUL.md are centrally managed in this repo's image — always
# overwrite from the image, unlike the official seed_one (first-boot only).
cp /opt/hermes-mentor/config.yaml "$HERMES_HOME/config.yaml"
cp /opt/hermes-mentor/SOUL.md "$HERMES_HOME/SOUL.md"
chown hermes:hermes "$HERMES_HOME/config.yaml" "$HERMES_HOME/SOUL.md"
chmod 640 "$HERMES_HOME/config.yaml"

# storage-cleanup.sh must live under $HERMES_HOME/scripts (the cron tool
# only accepts job scripts relative to that dir) and be hermes-owned, since
# the hermes user can't write into a root-owned scripts/ dir at runtime.
# Always overwrite from the image, same policy as config.yaml/SOUL.md.
mkdir -p "$HERMES_HOME/scripts"
cp /opt/hermes-mentor/scripts/storage-cleanup.sh "$HERMES_HOME/scripts/storage-cleanup.sh"
chown -R hermes:hermes "$HERMES_HOME/scripts"
chmod 755 "$HERMES_HOME/scripts/storage-cleanup.sh"

# --- One-time migration: hand the whole volume over to hermes ---
# Every deploy of this repo before commit 1f9646d ("move to Hermes docker
# image") ran on a plain `ubuntu:24.04` base with no s6-overlay and no
# privilege-drop concept at all -- ENV HOME=/root, CMD ["/root/entrypoint.sh"],
# the entire container (install, entrypoint, the agent process itself) ran
# as root, full stop, for the whole life of the deployment from the very
# first commit (886a000, May 2026) until the switch to the official
# nousresearch/hermes-agent image this morning.
#
# That means EVERY file already on this volume before that switch --
# repos/, kanban.db, MEMORY.md, state.db, all of it -- was written by a
# fully-root container. It isn't a handful of directories poisoned by an
# occasional `docker exec <c> hermes ...` call (that's the ongoing,
# small-scale case the targeted per-directory fixes below still guard
# against going forward); it's the ENTIRE pre-existing volume, one single
# historical fact, not scattered bugs. The right fix for a one-time
# regime change is a one-time full chown, not more per-directory
# allowlist entries.
#
# Marker-gated so this recursive chown -R (real cost: hundreds of repo
# files + an ~900MB state.db as of the migration) runs exactly ONCE, not
# on every future boot -- unlike the targeted per-directory checks below,
# which stay cheap forever specifically because they're scoped to a
# couple of small dirs.
MIGRATION_MARKER="$HERMES_HOME/.migrated_to_hermes_uid_20260925"
if [ ! -f "$MIGRATION_MARKER" ]; then
  echo "[hermes-mentor] One-time migration: chowning $HERMES_HOME to hermes:hermes (pre-s6-overlay volume was entirely root-owned)..."
  if chown -R hermes:hermes "$HERMES_HOME" 2>/dev/null; then
    date -u +"%Y-%m-%dT%H:%M:%SZ" > "$MIGRATION_MARKER"
    chown hermes:hermes "$MIGRATION_MARKER"
    echo "[hermes-mentor] Migration complete."
  else
    echo "[hermes-mentor] Warning: full-volume chown failed (rootless container?) -- some files may remain root-owned. Not writing the marker, will retry next boot."
  fi
fi

# --- Extra mentor-specific ownership fixes (ongoing, cheap, every boot) ---
# The official image's stage2-hook.sh deliberately does NOT blanket-chown
# $HERMES_HOME (it only fixes a documented allowlist: cron, sessions, logs,
# profiles, pairing, etc. -- see its own comments re: issue #19788, so a
# host bind-mounted volume with unrelated files is never touched). That
# caveat doesn't apply here: our Railway volume is dedicated to this
# deployment, nothing else lives on it, so it's safe to extend the same
# self-healing pattern to a few more dirs the agent genuinely needs to
# write into at runtime but that land root-owned (same cause as
# cron/profiles/pairing above: anything touched via `docker exec <c> hermes
# ...` or created by a root-context maintenance step defaults to uid 0).
#
# repos/    -- where the agent clones/pulls project repos directly (git
#              clone as the hermes user fails outright into a root-owned
#              parent dir -- hit this live while fixing this very script).
# vault/    -- local credential vault (browser_vault_* tools). Was 700
#              root:root, meaning the vault was 100% inaccessible to the
#              running agent on this deployment -- not a permissions nit,
#              a fully broken feature.
for d in repos vault; do
  if [ -d "$HERMES_HOME/$d" ]; then
    owner=$(stat -c %U "$HERMES_HOME/$d" 2>/dev/null || echo unknown)
    if [ "$owner" != "hermes" ]; then
      chown -R hermes:hermes "$HERMES_HOME/$d" 2>/dev/null || \
        echo "[hermes-mentor] Warning: could not chown $HERMES_HOME/$d"
    fi
  fi
done

# MEMORY.md is updated by the agent over time — seed once, never overwrite.
if [ ! -f "$HERMES_HOME/MEMORY.md" ]; then
  cp /opt/hermes-mentor/MEMORY.md "$HERMES_HOME/MEMORY.md"
  chown hermes:hermes "$HERMES_HOME/MEMORY.md"
fi

# Git identity from env vars, written directly to the volume's .gitconfig
# (main-wrapper.sh sets HOME=/opt/data for the hermes user at runtime, so
# this is the file git actually reads).
if [ -n "${GIT_USER_NAME:-}" ] && [ -n "${GIT_USER_EMAIL:-}" ]; then
  git config --file "$GITCONFIG" user.name "$GIT_USER_NAME"
  git config --file "$GITCONFIG" user.email "$GIT_USER_EMAIL"
fi

# GitHub auth via token — lets Hermes clone, push, browse repos.
if [ -n "${GITHUB_TOKEN:-}" ]; then
  git config --file "$GITCONFIG" credential.https://github.com.helper \
    "!f() { echo username=x-access-token; echo password=\$GITHUB_TOKEN; }; f"
  echo "[hermes-mentor] GitHub credential helper configured."
fi
[ -f "$GITCONFIG" ] && chown hermes:hermes "$GITCONFIG"

# Idempotent cron jobs. `hermes` is the privilege-drop shim (root -> hermes).
if [ -n "${TELEGRAM_CHAT_ID:-}" ]; then
  EXISTING=$(hermes cron list 2>/dev/null | grep -c "morning-brief" || true)
  if [ "$EXISTING" -eq 0 ]; then
    echo "[hermes-mentor] Creating cron jobs..."

    hermes cron create "0 8 * * *" \
      "You are Nilanjan's technical mentor. Use your browser to check recent activity on github.com/facebookincubator/velox, github.com/apache/spark, and github.com/apache/arrow. Send a morning brief with: 1) A side project idea related to data platforms or query engines that would make a good OSS contribution. 2) One interesting open issue or PR you found from those repos that matches a 3-year-exp engineer learning C++. 3) A concept to study today with a specific link. Keep it actionable and under 300 words." \
      --name "morning-brief" --deliver "telegram:${TELEGRAM_CHAT_ID}"

    hermes cron create "0 14 * * *" \
      "You are Nilanjan's technical mentor. Send ONE deep-dive learning nugget. Pick a topic from: distributed systems internals, query engine design (Velox/Gluten/Spark/Arrow), database storage engines, AI inference optimization, or data platform architecture. Go DEEP on one specific concept — explain the 'why' behind the design, not just the 'what'. Include: 1) The core insight (2-3 sentences), 2) Where to see it in code (specific repo, file, function — use your browser to verify the link works), 3) One small experiment to solidify understanding. Under 250 words." \
      --name "daily-deep-dive" --deliver "telegram:${TELEGRAM_CHAT_ID}"

    hermes cron create "0 20 * * 5" \
      "You are Nilanjan's technical mentor. It's Friday evening — send a weekend project challenge. Use your browser to find a real, specific problem to solve. Pick ONE: build a tiny query engine component, implement a distributed systems paper concept, write a Spark plugin, or build an AI agent tool. Include: what to build, why it's valuable, key repos/files to reference (verify links with browser), and definition of done. Completable in a weekend. Under 400 words." \
      --name "weekend-challenge" --deliver "telegram:${TELEGRAM_CHAT_ID}"

    echo "[hermes-mentor] Cron jobs created."
  else
    echo "[hermes-mentor] Cron jobs already exist, skipping."
  fi
fi
