# LLM Provider — choose one of the options below

# Option 1: AWS Bedrock
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-west-2

# Option 2: Anthropic API directly
# ANTHROPIC_API_KEY=

# Option 3: OpenRouter
# OPENROUTER_API_KEY=

# Telegram bot (create via @BotFather on Telegram)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALLOWED_USERS=

# Optional: Notion MCP (internal integration token from
# https://www.notion.so/profile/integrations - share only the pages you want
# the agent to see via each page's Connections menu). Set it as a Railway
# variable; the container adds the Notion MCP server on boot when it is set.
# NOTION_TOKEN=
